# Copy to .env.local for local development. Never commit real values.

# Image Worker for signed-out users (see worker/README.md). Optional.
VITE_ASSET_HOST=

# Signet accounts (Phase 2) — the SEPARATE Signet Supabase project, never the
# Modern Gentlemen website's. Leave empty to run local-only with no sign-in.
# Use the project URL and its publishable key (sb_publishable_…); both are
# safe in browser code because row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
