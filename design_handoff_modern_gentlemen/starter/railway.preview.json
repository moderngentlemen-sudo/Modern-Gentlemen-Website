{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run preview:check && npm run build"
  },
  "deploy": {
    "startCommand": "npm run preview:start",
    "healthcheckPath": "/_mg_preview/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
