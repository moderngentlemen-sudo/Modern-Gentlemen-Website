# Sanity — connect these to enable the CMS + section builder.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Shopify Storefront (if you go headless-Shopify for commerce)
# NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_token

# Stripe (if you use Stripe Checkout instead)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
